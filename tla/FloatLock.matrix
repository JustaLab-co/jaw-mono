# FloatLock: cap 2, price 1 unless a label says otherwise. Each section checks
# the properties its runs are about, so a failing run names one property.

# No drops and no faults: everything holds.
spec FloatLock.tla
check INVARIANTS TypeOK CapHolds MovedRecorded NoSendAfterEnd MovedReachesCaller
check PROPERTIES WaitEnds
reach ParkedWaiter | base refills=2
reach Ended | base refills=1 disc=1
run base refills=1 | Refills={r1} Discs={} Revokes={} Cap=2 Price=1 MaxDrops=0 LostReply=FALSE TxFault=FALSE
run base refills=2 | Refills={r1,r2} Discs={} Revokes={} Cap=2 Price=1 MaxDrops=0 LostReply=FALSE TxFault=FALSE
run base refills=3 | Refills={r1,r2,r3} Discs={} Revokes={} Cap=2 Price=1 MaxDrops=0 LostReply=FALSE TxFault=FALSE
run base refills=1 disc=1 | Refills={r1} Discs={d1} Revokes={} Cap=2 Price=1 MaxDrops=0 LostReply=FALSE TxFault=FALSE
run base refills=2 disc=1 | Refills={r1,r2} Discs={d1} Revokes={} Cap=2 Price=1 MaxDrops=0 LostReply=FALSE TxFault=FALSE

# (a) the cap, with the lock session dropping, and with a failed reserve tx.
spec FloatLock.tla
check INVARIANTS TypeOK CapHolds
reach LockStolen | cap refills=2 drops=2
reach LostSeen | cap refills=2 drops=2
run cap refills=2 drops=2 | Refills={r1,r2} Discs={} Revokes={} Cap=2 Price=1 MaxDrops=2 LostReply=FALSE TxFault=FALSE
run cap refills=3 drops=1 | Refills={r1,r2,r3} Discs={} Revokes={} Cap=2 Price=1 MaxDrops=1 LostReply=FALSE TxFault=FALSE
run cap refills=3 drops=2 | Refills={r1,r2,r3} Discs={} Revokes={} Cap=2 Price=1 MaxDrops=2 LostReply=FALSE TxFault=FALSE
run cap=1 refills=2 drops=1 | Refills={r1,r2} Discs={} Revokes={} Cap=1 Price=1 MaxDrops=1 LostReply=FALSE TxFault=FALSE
run cap refills=3 txfault | Refills={r1,r2,r3} Discs={} Revokes={} Cap=2 Price=1 MaxDrops=0 LostReply=FALSE TxFault=TRUE

# (c) no top-up after the connection ended: disconnect with a drop, revokeByGrant without.
spec FloatLock.tla
check INVARIANTS TypeOK NoSendAfterEnd
run end refills=1 disc=1 drops=1 | Refills={r1} Discs={d1} Revokes={} Cap=2 Price=1 MaxDrops=1 LostReply=FALSE TxFault=FALSE
run end refills=2 disc=1 drops=2 | Refills={r1,r2} Discs={d1} Revokes={} Cap=2 Price=1 MaxDrops=2 LostReply=FALSE TxFault=FALSE
run end refills=1 revoke=1 drops=0 | Refills={r1} Discs={} Revokes={v1} Cap=2 Price=1 MaxDrops=0 LostReply=FALSE TxFault=FALSE

# (b) and (d) with drops and both faults, then the lost reply alone.
spec FloatLock.tla
check INVARIANTS TypeOK MovedRecorded MovedReachesCaller
run money refills=2 disc=1 drops=2 txfault | Refills={r1,r2} Discs={d1} Revokes={} Cap=2 Price=1 MaxDrops=2 LostReply=FALSE TxFault=TRUE
run money refills=1 lostreply | Refills={r1} Discs={} Revokes={} Cap=2 Price=1 MaxDrops=0 LostReply=TRUE TxFault=FALSE

# (e) liveness with drops allowed and every kind of turn.
spec FloatLock.tla
check PROPERTIES WaitEnds
run wait refills=2 disc=1 drops=2 | Refills={r1,r2} Discs={d1} Revokes={} Cap=2 Price=1 MaxDrops=2 LostReply=FALSE TxFault=FALSE
run wait refills=2 revoke=1 drops=1 | Refills={r1,r2} Discs={} Revokes={v1} Cap=2 Price=1 MaxDrops=1 LostReply=FALSE TxFault=FALSE
