# FloatLock: cap 2, price 1 unless a label says otherwise. Each section checks
# the properties its runs are about, so a failing run names one property.

# No drops and no faults: everything holds.
spec FloatLock.tla
check INVARIANTS TypeOK CapHolds MovedRecorded NoSendAfterEnd MovedReachesCaller
check PROPERTIES WaitEnds
reach ParkedWaiter | base refills=2
reach Ended | base refills=1 disc=1
run base refills=1 | Refills={r1} Discs={} Revokes={} Execs={} Cap=2 Price=1 ExecCap=1 MaxDrops=0 LostReply=FALSE TxFault=FALSE
run base refills=2 | Refills={r1,r2} Discs={} Revokes={} Execs={} Cap=2 Price=1 ExecCap=1 MaxDrops=0 LostReply=FALSE TxFault=FALSE
run base refills=3 | Refills={r1,r2,r3} Discs={} Revokes={} Execs={} Cap=2 Price=1 ExecCap=1 MaxDrops=0 LostReply=FALSE TxFault=FALSE
run base refills=1 disc=1 | Refills={r1} Discs={d1} Revokes={} Execs={} Cap=2 Price=1 ExecCap=1 MaxDrops=0 LostReply=FALSE TxFault=FALSE
run base refills=2 disc=1 | Refills={r1,r2} Discs={d1} Revokes={} Execs={} Cap=2 Price=1 ExecCap=1 MaxDrops=0 LostReply=FALSE TxFault=FALSE

# (a) the cap, with the lock session dropping, and with a failed reserve tx;
# (f) no top-up written after the lock was taken from its turn.
spec FloatLock.tla
check INVARIANTS TypeOK CapHolds NoStaleTopUp
reach LockStolen | cap refills=2 drops=2
reach LostSeen | cap refills=2 drops=2
run cap refills=2 drops=2 | Refills={r1,r2} Discs={} Revokes={} Execs={} Cap=2 Price=1 ExecCap=1 MaxDrops=2 LostReply=FALSE TxFault=FALSE
run cap refills=3 drops=1 | Refills={r1,r2,r3} Discs={} Revokes={} Execs={} Cap=2 Price=1 ExecCap=1 MaxDrops=1 LostReply=FALSE TxFault=FALSE
run cap refills=3 drops=2 | Refills={r1,r2,r3} Discs={} Revokes={} Execs={} Cap=2 Price=1 ExecCap=1 MaxDrops=2 LostReply=FALSE TxFault=FALSE
run cap=1 refills=2 drops=1 | Refills={r1,r2} Discs={} Revokes={} Execs={} Cap=1 Price=1 ExecCap=1 MaxDrops=1 LostReply=FALSE TxFault=FALSE
run cap refills=3 txfault | Refills={r1,r2,r3} Discs={} Revokes={} Execs={} Cap=2 Price=1 ExecCap=1 MaxDrops=0 LostReply=FALSE TxFault=TRUE

# (c) no top-up after the connection ended: disconnect with a drop, revokeByGrant without.
spec FloatLock.tla
check INVARIANTS TypeOK NoSendAfterEnd
run end refills=1 disc=1 drops=1 | Refills={r1} Discs={d1} Revokes={} Execs={} Cap=2 Price=1 ExecCap=1 MaxDrops=1 LostReply=FALSE TxFault=FALSE
run end refills=2 disc=1 drops=2 | Refills={r1,r2} Discs={d1} Revokes={} Execs={} Cap=2 Price=1 ExecCap=1 MaxDrops=2 LostReply=FALSE TxFault=FALSE
run end refills=1 revoke=1 drops=0 | Refills={r1} Discs={} Revokes={v1} Execs={} Cap=2 Price=1 ExecCap=1 MaxDrops=0 LostReply=FALSE TxFault=FALSE

# (b) and (d) with drops and both faults, then the lost reply alone.
spec FloatLock.tla
check INVARIANTS TypeOK MovedRecorded MovedReachesCaller
run money refills=2 disc=1 drops=2 txfault | Refills={r1,r2} Discs={d1} Revokes={} Execs={} Cap=2 Price=1 ExecCap=1 MaxDrops=2 LostReply=FALSE TxFault=TRUE
run money refills=1 lostreply | Refills={r1} Discs={} Revokes={} Execs={} Cap=2 Price=1 ExecCap=1 MaxDrops=0 LostReply=TRUE TxFault=FALSE

# (e) liveness with drops allowed and every kind of turn.
spec FloatLock.tla
check PROPERTIES WaitEnds
run wait refills=2 disc=1 drops=2 | Refills={r1,r2} Discs={d1} Revokes={} Execs={} Cap=2 Price=1 ExecCap=1 MaxDrops=2 LostReply=FALSE TxFault=FALSE
run wait refills=2 revoke=1 drops=1 | Refills={r1,r2} Discs={} Revokes={v1} Execs={} Cap=2 Price=1 ExecCap=1 MaxDrops=1 LostReply=FALSE TxFault=FALSE

# (g) and (h) the execute turn: a grant limit of 1 or 2, drops, and receipts that
# land and settle at any time, beside a refill, a disconnect and a revokeByGrant.
spec FloatLock.tla
check INVARIANTS TypeOK ExecCapHolds ExecRecorded CountedOnce NoExecAfterEnd CapHolds
reach ExecCountedTwice | exec execs=2 drops=0
reach ExecStolen | exec execs=2 drops=1
run exec execs=2 drops=0 | Refills={} Discs={} Revokes={} Execs={e1,e2} Cap=2 Price=1 ExecCap=1 MaxDrops=0 LostReply=FALSE TxFault=FALSE
run exec execs=2 drops=1 | Refills={} Discs={} Revokes={} Execs={e1,e2} Cap=2 Price=1 ExecCap=1 MaxDrops=1 LostReply=FALSE TxFault=FALSE
run exec execs=3 cap=2 drops=2 | Refills={} Discs={} Revokes={} Execs={e1,e2,e3} Cap=2 Price=1 ExecCap=2 MaxDrops=2 LostReply=FALSE TxFault=FALSE
run exec execs=2 refills=1 drops=1 | Refills={r1} Discs={} Revokes={} Execs={e1,e2} Cap=2 Price=1 ExecCap=1 MaxDrops=1 LostReply=FALSE TxFault=FALSE
run exec execs=2 disc=1 drops=1 | Refills={} Discs={d1} Revokes={} Execs={e1,e2} Cap=2 Price=1 ExecCap=1 MaxDrops=1 LostReply=FALSE TxFault=FALSE
run exec execs=1 revoke=1 | Refills={} Discs={} Revokes={v1} Execs={e1} Cap=2 Price=1 ExecCap=1 MaxDrops=0 LostReply=FALSE TxFault=FALSE

# (e) liveness with executes waiting on the lock.
spec FloatLock.tla
check PROPERTIES WaitEnds
run wait execs=2 refills=1 drops=1 | Refills={r1} Discs={} Revokes={} Execs={e1,e2} Cap=2 Price=1 ExecCap=1 MaxDrops=1 LostReply=FALSE TxFault=FALSE
