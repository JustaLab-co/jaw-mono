# Matrix for FloatSlots.tla. Slot counts 1, 2 and the shipped 16; two and
# three callers on one or two connections; the PGlite branch.

spec FloatSlots.tla
check INVARIANTS TypeOK SlotConservation NoStrandedWaiter NoGrantAfterTimeout SessionsCount TurnExclusive NoOrphanFloat
check PROPERTIES TakeSettles AllAnswered QueuesCleared SessionsCleared
reach WaiterParked | slots=1 direct=3
reach TakeTimedOut | slots=1 direct=3
reach CapFull | slots=1 direct=3
reach TimedOutStillQueued | slots=2 refill=3
reach TimedOutThenStarted | slots=2 refill=3
reach Chained | slots=2 refill=3
reach EntryKeptForLater | slots=2 refill=3
reach PgChained | pglite refill=2
run slots=1 direct=3 conn=1 | Refill={} Direct={d1,d2,d3} OnA={d1,d2,d3} Slots=1 Pglite=FALSE
run slots=1 refill=2 direct=1 conn=1 | Refill={r1,r2} Direct={d1} OnA={r1,r2,d1} Slots=1 Pglite=FALSE
run slots=2 refill=3 conn=1 | Refill={r1,r2,r3} Direct={} OnA={r1,r2,r3} Slots=2 Pglite=FALSE
run slots=1 refill=2 direct=1 conns=2 | Refill={r1,r2} Direct={d1} OnA={r1,d1} Slots=1 Pglite=FALSE
run slots=2 refill=1 direct=2 conn=1 | Refill={r1} Direct={d1,d2} OnA={r1,d1,d2} Slots=2 Pglite=FALSE
run slots=16 refill=2 direct=1 conn=1 | Refill={r1,r2} Direct={d1} OnA={r1,r2,d1} Slots=16 Pglite=FALSE
run pglite refill=2 direct=1 conn=1 | Refill={r1,r2} Direct={d1} OnA={r1,r2,d1} Slots=16 Pglite=TRUE
