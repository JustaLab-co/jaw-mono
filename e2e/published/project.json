{
  "name": "published-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "implicitDependencies": ["@jaw.id/core", "@jaw.id/wagmi", "@jaw.id/ui", "@jaw.id/cli"],
  "targets": {
    "e2e": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "bash e2e/published/run.sh"
      },
      "inputs": ["{projectRoot}/**/*", "{workspaceRoot}/.verdaccio/config.yml", "^production"]
    }
  }
}
