# Run affected build, test, and lint tasks, excluding docs app.
# Compares against the PR base, as CI does, so a stacked branch checks only its
# own commits. Falls back to main when gh fails or the branch has no PR.
base=$(gh pr view --json baseRefName -q .baseRefName 2>/dev/null) || base=
[ -n "$base" ] || base=main
git fetch -q origin "$base" 2>/dev/null
echo "pre-push: nx affected against origin/$base"
nx affected -t build,test,lint --base="origin/$base" --head=HEAD --exclude=docs
