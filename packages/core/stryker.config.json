{
  "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "mutate": ["src/**/*.ts", "!src/**/*.test.ts", "!src/**/*.test-utils.ts", "!src/sdk-info.ts"],
  "ignoreStatic": true,
  "reporters": ["clear-text", "html", "json"],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  }
}
