{
  "name": "@jaw.id/ui",
  "description": "Pre-built React dialogs for JAW.id",
  "version": "1.5.1",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./src/styles.css",
    "./dist/index.css"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/JustaLab-co/jaw-mono.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "cjs-error.cjs",
    "!**/*.tsbuildinfo"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@jaw-mono/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./cjs-error.cjs",
      "default": "./dist/index.js"
    }
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "^build"
        ],
        "cache": true,
        "inputs": [
          "production",
          "^production",
          {
            "externalDependencies": [
              "vite",
              "typescript"
            ]
          }
        ],
        "outputs": [
          "{projectRoot}/dist"
        ],
        "options": {
          "cwd": "{projectRoot}",
          "commands": [
            "vite build",
            "tsc --build tsconfig.lib.json"
          ],
          "parallel": false
        }
      },
      "test": {
        "cache": true,
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "default",
          "^production",
          "{projectRoot}/vitest.config.ts"
        ],
        "executor": "nx:run-commands",
        "options": {
          "cwd": "{projectRoot}",
          "command": "bunx vitest run"
        }
      }
    }
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@jaw.id/core": "1.5.1",
    "@hookform/resolvers": "^5.2.2",
    "@justaname.id/sdk": "^0.3.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.9",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@shazow/whatsabi": "^0.26.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.545.0",
    "minidenticons": "^4.2.1",
    "qrcode-generator": "2.0.4",
    "react-hook-form": "^7.65.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "viem": "^2.56.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "3",
    "vite-plugin-lib-inject-css": "^2.2.2"
  }
}
