      "kind": "theorem",
      "type": "∀ (table : RelayOrderView.Table) (rs : List RelayOrderView.Refund) (rows : List (Nat × Nat)), RelayOrderView.refundRows table rs = some rows → (List.map Prod.fst rows).Nodup ∧ (∀ (row : Nat × Nat), row ∈ rows → ∃ r, r ∈ rs ∧ table r.chain = some row.fst ∧ RelayOrderView.isAddress r.recipient = true ∧ r.recipient.val = row.snd) ∧ ∀ (r : RelayOrderView.Refund), r ∈ rs → ∃ row, row ∈ rows ∧ table r.chain = some row.fst ∧ row.snd = r.recipient.val",
