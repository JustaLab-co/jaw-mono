    },
    {
      "name": "FeePreselect.preselect_member",
      "kind": "theorem",
      "type": "∀ (ts : List FeePreselect.Tok) (need : Nat) (p : FeePreselect.Tok), FeePreselect.preselectFeeToken ts need = some p → p ∈ ts",
      "typeHash": "6d932bfcca798afbd18cab6256bf548ec3c8ddf35918a2dbc80764ddc3242460",
      "valueHash": null
    },
    {
      "name": "FeePreselect.preselect_none_iff",
      "kind": "theorem",
      "type": "∀ (ts : List FeePreselect.Tok) (need : Nat), FeePreselect.preselectFeeToken ts need = none ↔ FeePreselect.coinCovers ts need = false ∧ ∀ (t : FeePreselect.Tok), t ∈ ts → FeePreselect.provenErc20 t = false",
      "typeHash": "d96840bffbec4714eec120c6358e4f1b4593942fa12b46aba6b3556a9683429e",
      "valueHash": null
    },
    {
      "name": "FeePreselect.preselect_prefers_coin",
      "kind": "theorem",
      "type": "∀ (ts : List FeePreselect.Tok) (need : Nat), FeePreselect.coinCovers ts need = true → ∃ c, List.find? (fun x => x.isNative) ts = some c ∧ FeePreselect.preselectFeeToken ts need = some c",
      "typeHash": "6b93b5cbf8b10218cd066d6abc93888e8e68a17e986a162638c190281403710b",
      "valueHash": null
    },
    {
      "name": "FeePreselect.preselect_solvent",
      "kind": "theorem",
      "type": "∀ (ts : List FeePreselect.Tok) (need : Nat) (p : FeePreselect.Tok), FeePreselect.preselectFeeToken ts need = some p → p.isNative = true ∧ need ≤ p.balance ∨ p.isNative = false ∧ p.selectable = true ∧ p.priced = true",
      "typeHash": "af7c852be54eaf7c262cfff625b0a029658f37fddf8314febeeeab727c97f182",
      "valueHash": null
    },
    {
      "name": "FeePreselect.provenErc20",
