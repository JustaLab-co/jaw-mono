    },
    {
      "name": "FeePreselect.preselectFeeToken.eq_1",
      "kind": "theorem",
      "type": "∀ (ts : List FeePreselect.Tok) (need : Nat), FeePreselect.preselectFeeToken ts need = match List.find? (fun x => x.isNative) ts with | some c => if need ≤ c.balance then some c else List.find? FeePreselect.provenErc20 ts | none => List.find? FeePreselect.provenErc20 ts",
      "typeHash": "fff6a36038c4830ba1be271aedb989d5ba0f350e7e71624c56573220fa805ce6",
      "valueHash": null
    },
    {
      "name": "FeePreselect.preselectFeeToken.match_1",
      "kind": "definition",
      "type": "(motive : Option FeePreselect.Tok → Sort u_1) → (x : Option FeePreselect.Tok) → ((c : FeePreselect.Tok) → motive (some c)) → (Unit → motive none) → motive x",
      "typeHash": "f3e135ba4cb0e7c1bde5c4f1df04c915a66e81e382f5fa73e68026ec62f00826",
      "valueHash": "cda8ee95a954a4bbff58eb18872a291ace4858083693616f53310edfb88e74d5"
    },
    {
      "name": "FeePreselect.preselectFeeToken.match_1.eq_1",
      "kind": "theorem",
      "type": "∀ (motive : Option FeePreselect.Tok → Sort u_1) (c : FeePreselect.Tok) (h_1 : (c : FeePreselect.Tok) → motive (some c)) (h_2 : Unit → motive none), (match some c with | some c => h_1 c | none => h_2 ()) = h_1 c",
      "typeHash": "968a1ab0e2fc418d8c4d770f4e6d5b15ff2348ff70c906b13e9a82c4ed461786",
      "valueHash": null
    },
    {
      "name": "FeePreselect.preselectFeeToken.match_1.eq_2",
      "kind": "theorem",
      "type": "∀ (motive : Option FeePreselect.Tok → Sort u_1) (h_1 : (c : FeePreselect.Tok) → motive (some c)) (h_2 : Unit → motive none), (match none with | some c => h_1 c | none => h_2 ()) = h_2 ()",
      "typeHash": "431913cc8b2d9860e1f2761924e1dadfb1fe9ea65c413f58114d0a4e25340463",
      "valueHash": null
    },
    {
      "name": "FeePreselect.preselectFeeToken.match_1.splitter",
      "kind": "definition",
      "type": "(motive : Option FeePreselect.Tok → Sort u_1) → (x : Option FeePreselect.Tok) → ((c : FeePreselect.Tok) → motive (some c)) → (Unit → motive none) → motive x",
