    },
    {
      "name": "FeePreselect.handleEthSuccess.eq_1",
      "kind": "theorem",
      "type": "∀ (s : FeePreselect.State) (ts : List FeePreselect.Tok) (need : Nat), FeePreselect.handleEthSuccess s ts need = if ts.isEmpty = true then { sel := s.sel, ownerPick := s.ownerPick, err := false } else have pick := FeePreselect.preselectFeeToken ts need; { sel := if FeePreselect.ownerHolds s = true then s.sel else pick, ownerPick := s.ownerPick, err := match pick with | some p => !p.isNative | none => true }",
      "typeHash": "de027576e6cb01258722efadb81e6cedf1de54d41d9dfe3e3ca12766781883ea",
      "valueHash": null
    },
