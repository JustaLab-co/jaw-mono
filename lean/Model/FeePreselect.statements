    },
    {
      "name": "FeePreselect.ownerHolds.eq_1",
      "kind": "theorem",
      "type": "∀ (s : FeePreselect.State), FeePreselect.ownerHolds s = (s.sel.isSome && s.sel == s.ownerPick)",
      "typeHash": "70b3f3eb9ee0b834ac20d5ed080cf01f4106566e6a3bc077cf27bf8d5fcfa21f",
      "valueHash": null
    },
    {
      "name": "FeePreselect.pickFeeToken",
      "kind": "definition",
      "type": "FeePreselect.State → Option FeePreselect.Tok → FeePreselect.State",
      "typeHash": "f39e633f5434c843482cc115b60367321f108a4c5c7acb3b7b46d51df8872ad9",
      "valueHash": "61ba2f139d0c7c1c693ed238bf582c90b1e45fef69bf214e23f89eb4e80dbf82"
    },
    {
      "name": "FeePreselect.pickFeeToken.eq_1",
      "kind": "theorem",
      "type": "∀ (s : FeePreselect.State) (t : Option FeePreselect.Tok), FeePreselect.pickFeeToken s t = { sel := t, ownerPick := t, err := s.err }",
      "typeHash": "9e1294f824717bcb3491a1dc2352bcdb3330e994d3e4ccc729e3b0c3d8a68761",
      "valueHash": null
    },
    {
      "name": "FeePreselect.pick_is_owner",
      "kind": "theorem",
      "type": "∀ (s : FeePreselect.State) (t : FeePreselect.Tok), FeePreselect.ownerHolds (FeePreselect.pickFeeToken s (some t)) = true",
      "typeHash": "2c353ba3df4b781af4bb9c10a16ed98c633aac67a0907acd4501a2aac461d483",
      "valueHash": null
    },
    {
      "name": "FeePreselect.preselectFeeToken",
      "kind": "definition",
      "type": "List FeePreselect.Tok → Nat → Option FeePreselect.Tok",
      "typeHash": "476cc91d162e2c4d657d538fd3332efd500e2cebd3903dad8944949ee876ae1e",
      "valueHash": "bd8a644847787d2ca24675dd798a5f59603a9fcad36b2192d764819a59461856"
    },
    {
      "name": "FeePreselect.preselectFeeToken.eq_1",
      "kind": "theorem",
      "type": "∀ (ts : List FeePreselect.Tok) (need : Nat), FeePreselect.preselectFeeToken ts need = match List.find? (fun x => x.isNative) ts with | some c => if need ≤ c.balance then some c else List.find? FeePreselect.provenErc20 ts | none => List.find? FeePreselect.provenErc20 ts",
      "typeHash": "fff6a36038c4830ba1be271aedb989d5ba0f350e7e71624c56573220fa805ce6",
      "valueHash": null
    },
    {
      "name": "FeePreselect.preselectFeeToken.match_1",
      "kind": "definition",
      "type": "(motive : Option FeePreselect.Tok → Sort u_1) → (x : Option FeePreselect.Tok) → ((c : FeePreselect.Tok) → motive (some c)) → (Unit → motive none) → motive x",
      "typeHash": "f3e135ba4cb0e7c1bde5c4f1df04c915a66e81e382f5fa73e68026ec62f00826",
      "valueHash": "cda8ee95a954a4bbff58eb18872a291ace4858083693616f53310edfb88e74d5"
    },
    {
      "name": "FeePreselect.preselectFeeToken.match_1.eq_1",
      "kind": "theorem",
      "type": "∀ (motive : Option FeePreselect.Tok → Sort u_1) (c : FeePreselect.Tok) (h_1 : (c : FeePreselect.Tok) → motive (some c)) (h_2 : Unit → motive none), (match some c with | some c => h_1 c | none => h_2 ()) = h_1 c",
      "typeHash": "968a1ab0e2fc418d8c4d770f4e6d5b15ff2348ff70c906b13e9a82c4ed461786",
      "valueHash": null
    },
    {
      "name": "FeePreselect.preselectFeeToken.match_1.eq_2",
      "kind": "theorem",
      "type": "∀ (motive : Option FeePreselect.Tok → Sort u_1) (h_1 : (c : FeePreselect.Tok) → motive (some c)) (h_2 : Unit → motive none), (match none with | some c => h_1 c | none => h_2 ()) = h_2 ()",
      "typeHash": "431913cc8b2d9860e1f2761924e1dadfb1fe9ea65c413f58114d0a4e25340463",
      "valueHash": null
    },
    {
      "name": "FeePreselect.preselectFeeToken.match_1.splitter",
      "kind": "definition",
      "type": "(motive : Option FeePreselect.Tok → Sort u_1) → (x : Option FeePreselect.Tok) → ((c : FeePreselect.Tok) → motive (some c)) → (Unit → motive none) → motive x",
      "typeHash": "f3e135ba4cb0e7c1bde5c4f1df04c915a66e81e382f5fa73e68026ec62f00826",
      "valueHash": "59884596b6ef0deafd5587cfbd7623fafedcbf386f5aceafac6dc91cd6f2bd9f"
    },
    {
      "name": "FeePreselect.preselect_member",
      "kind": "theorem",
      "type": "∀ (ts : List FeePreselect.Tok) (need : Nat) (p : FeePreselect.Tok), FeePreselect.preselectFeeToken ts need = some p → p ∈ ts",
      "typeHash": "6d932bfcca798afbd18cab6256bf548ec3c8ddf35918a2dbc80764ddc3242460",
      "valueHash": null
    },
    {
      "name": "FeePreselect.preselect_none_iff",
      "kind": "theorem",
      "type": "∀ (ts : List FeePreselect.Tok) (need : Nat), FeePreselect.preselectFeeToken ts need = none ↔ FeePreselect.coinCovers ts need = false ∧ ∀ (t : FeePreselect.Tok), t ∈ ts → FeePreselect.provenErc20 t = false",
      "typeHash": "d96840bffbec4714eec120c6358e4f1b4593942fa12b46aba6b3556a9683429e",
      "valueHash": null
    },
    {
      "name": "FeePreselect.preselect_prefers_coin",
      "kind": "theorem",
      "type": "∀ (ts : List FeePreselect.Tok) (need : Nat), FeePreselect.coinCovers ts need = true → ∃ c, List.find? (fun x => x.isNative) ts = some c ∧ FeePreselect.preselectFeeToken ts need = some c",
      "typeHash": "6b93b5cbf8b10218cd066d6abc93888e8e68a17e986a162638c190281403710b",
      "valueHash": null
    },
    {
      "name": "FeePreselect.preselect_solvent",
      "kind": "theorem",
      "type": "∀ (ts : List FeePreselect.Tok) (need : Nat) (p : FeePreselect.Tok), FeePreselect.preselectFeeToken ts need = some p → p.isNative = true ∧ need ≤ p.balance ∨ p.isNative = false ∧ p.selectable = true ∧ p.priced = true",
      "typeHash": "af7c852be54eaf7c262cfff625b0a029658f37fddf8314febeeeab727c97f182",
      "valueHash": null
    },
    {
      "name": "FeePreselect.provenErc20",
      "kind": "definition",
      "type": "FeePreselect.Tok → Bool",
      "typeHash": "506c66a59e7527546e54553e7f1c9868004e76ea8c9630be7f669d17cdd73357",
      "valueHash": "226d7e6b365ddacece68f21b4a384d6622e269bd8abb562304aa1ba1246ff1d5"
    },
    {
      "name": "FeePreselect.provenErc20.eq_1",
      "kind": "theorem",
      "type": "∀ (t : FeePreselect.Tok), FeePreselect.provenErc20 t = (!t.isNative && t.selectable && t.priced)",
      "typeHash": "848ec930a9bd9d7025f4beb0f08b51569dfbe2e989646c0d28b58f8e8def6e34",
      "valueHash": null
    },
    {
      "name": "FeePreselect.proven_not_coin",
      "kind": "theorem",
      "type": "∀ {t : FeePreselect.Tok}, FeePreselect.provenErc20 t = true → t.isNative = false",
      "typeHash": "50a3a63650a2077aeaab07e834f8319ac37461527e77da2748b2ab41f6796b23",
      "valueHash": null
    },
    {
      "name": "FeePreselect.reset_hands_back",
      "kind": "theorem",
      "type": "∀ (s : FeePreselect.State), FeePreselect.ownerHolds (FeePreselect.pickFeeToken s none) = false",
      "typeHash": "3c065afbf2576421a818d578db359d550399c442004e586f431ab4dde05c9d62",
      "valueHash": null
    },
    {
      "name": "FeePreselect.solvent",
      "kind": "definition",
      "type": "List FeePreselect.Tok → Nat → Bool",
      "typeHash": "384f218465ddc54ee9c657d3613c8d005a12a8848e057063522fa183013e88f2",
      "valueHash": "54954ddabb61cb96229a083c0fd3f6810643fd9569a08bcdf3ecf3a2d79c3e7b"
    },
    {
      "name": "FeePreselect.step_err_iff",
      "kind": "theorem",
      "type": "∀ (s : FeePreselect.State) (ts : List FeePreselect.Tok) (need : Nat), ts ≠ [] → ((FeePreselect.handleEthSuccess s ts need).err = true ↔ FeePreselect.coinCovers ts need = false)",
      "typeHash": "c6d78ea101c45507f5259b1e0506497c491bdb5bf581446afecce2ca92582163",
      "valueHash": null
    },
    {
      "name": "FeePreselect.step_keeps_owner_pick",
      "kind": "theorem",
      "type": "∀ (s : FeePreselect.State) (ts : List FeePreselect.Tok) (need : Nat), FeePreselect.ownerHolds s = true → (FeePreselect.handleEthSuccess s ts need).sel = s.sel",
      "typeHash": "dabdd136e2cfa12570575b7f75644e48ac333db38b11655a0248fb6d94b341f3",
      "valueHash": null
    },
    {
      "name": "FeePreselect.step_takes_preselect",
      "kind": "theorem",
      "type": "∀ (s : FeePreselect.State) (ts : List FeePreselect.Tok) (need : Nat), FeePreselect.ownerHolds s = false → ts ≠ [] → (FeePreselect.handleEthSuccess s ts need).sel = FeePreselect.preselectFeeToken ts need",
      "typeHash": "dd929937366d8e5e576fb90b961a6e189f58ba1e675519cb590d0a5903a8f7d4",
      "valueHash": null
    },
    {
