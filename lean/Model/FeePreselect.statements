      "type": "∀ (s : FeePreselect.State), (FeePreselect.pickFeeToken s none).owner = false",
      "typeHash": "a0c55e57a8e548815cb035aba0556dd289d60b632a20c95a8e4bb7f7b241a658",
      "valueHash": null
    },
