    {
      "name": "FeePreselect.step_err_iff",
      "kind": "theorem",
      "type": "∀ (s : FeePreselect.State) (ts : List FeePreselect.Tok) (need : Nat), ts ≠ [] → ((FeePreselect.handleEthSuccess s ts need).err = true ↔ FeePreselect.coinCovers ts need = false)",
      "typeHash": "c6d78ea101c45507f5259b1e0506497c491bdb5bf581446afecce2ca92582163",
      "valueHash": null
    },
    {
      "name": "FeePreselect.step_keeps_owner_pick",
      "kind": "theorem",
      "type": "∀ (s : FeePreselect.State) (ts : List FeePreselect.Tok) (need : Nat), s.owner = true → (FeePreselect.handleEthSuccess s ts need).sel = s.sel",
      "typeHash": "c0407804ba4722a5c51e5d53ac679b5d7876c4acb4351af3b43add9f2b889055",
      "valueHash": null
    },
    {
      "name": "FeePreselect.step_takes_preselect",
      "kind": "theorem",
      "type": "∀ (s : FeePreselect.State) (ts : List FeePreselect.Tok) (need : Nat), s.owner = false → ts ≠ [] → (FeePreselect.handleEthSuccess s ts need).sel = FeePreselect.preselectFeeToken ts need",
      "typeHash": "aada35218cfa9418282457ddff22d8fc783aa608b2621482bbedc31b9b0c545e",
      "valueHash": null
    },
