      "kind": "definition",
      "type": "List FeePreselect.Tok",
      "typeHash": "f40c6a402e88d469c1dc9d704926e97ca05ae2924a4da794c43ccbff310a30ec",
      "valueHash": "9c83727b81210c2964059f4f098c9c2c2915554e35760d6c0b76c0901ad8e752"
    },
