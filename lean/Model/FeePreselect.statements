    {
      "name": "FeePreselect.handleEthSuccess.eq_1",
      "kind": "theorem",
      "type": "∀ (s : FeePreselect.State) (ts : List FeePreselect.Tok) (need : Nat), FeePreselect.handleEthSuccess s ts need = if ts.isEmpty = true then { sel := s.sel, owner := s.owner, err := false } else have pick := FeePreselect.preselectFeeToken ts need; { sel := if s.owner = true then s.sel else pick, owner := s.owner, err := match pick with | some p => !p.isNative | none => true }",
      "typeHash": "8bd909a7114a2a63e0adf67cb6abe7209d815cd7ea2b062776c2544eb805560c",
      "valueHash": null
    },
