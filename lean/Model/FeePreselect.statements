    {
      "name": "FeePreselect.coinCovers.eq_1",
      "kind": "theorem",
      "type": "∀ (ts : List FeePreselect.Tok) (need : Nat), FeePreselect.coinCovers ts need = match List.find? (fun x => x.isNative) ts with | some c => decide (need ≤ c.balance) | none => false",
      "typeHash": "b07ecb0c771878494a4f06c96634a9149869baa23b3bffdb7e0a4cc9a7d638df",
      "valueHash": null
