      "kind": "theorem",
      "type": "∀ (s : FeePreselect.State) (t : Option FeePreselect.Tok), FeePreselect.fallback s t = { sel := t, ownerPick := s.ownerPick, err := s.err }",
      "typeHash": "309ded6b3ac862f3f2f326d55e2d0f5c4acbd8b09962f73ceed0125f4a048599",
      "valueHash": null
    },
    {
      "name": "FeePreselect.fallback_hands_back",
      "kind": "theorem",
      "type": "∀ (s : FeePreselect.State) (t : Option FeePreselect.Tok), t ≠ s.ownerPick → FeePreselect.ownerHolds (FeePreselect.fallback s t) = false",
      "typeHash": "f857482e6a296c8000ea9a816719746b183efe3fa101841f5b6749bdf7121181",
      "valueHash": null
    },
    {
      "name": "FeePreselect.find_holds",
      "kind": "theorem",
      "type": "∀ {p : FeePreselect.Tok → Bool} {ts : List FeePreselect.Tok} {t : FeePreselect.Tok}, List.find? p ts = some t → p t = true",
      "typeHash": "60361078fc8b1f07518b675c7178487b82157bd2a44f8d2565a8e9be0cde6b80",
      "valueHash": null
    },
    {
      "name": "FeePreselect.handleEthSuccess",
      "kind": "definition",
      "type": "FeePreselect.State → List FeePreselect.Tok → Nat → FeePreselect.State",
      "typeHash": "949d7a9eb51ba781fc3870b35a234a22bc925ee5a3bd8fa91a87a953ed8ea124",
