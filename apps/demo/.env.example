# JAW API key (create one at https://dashboard.jaw.id/)
NEXT_PUBLIC_API_KEY=your-api-key-here
# keys.jaw.id URL (explicit override; defaults to production when unset).
# Local dev points at the local keys app. On Vercel preview deployments, leave
# this unset so the demo auto-targets this PR's own keys preview.
NEXT_PUBLIC_KEYS_URL=http://localhost:3001

# ENS parent the keys app issues subnames from (user.justan.id). Must be a
# domain owned by the same project as NEXT_PUBLIC_API_KEY above — subname
# issuance is scoped to that project. Leave unset and onboarding shows a bare
# username with no ENS suffix.
NEXT_PUBLIC_ENS=justan.id

# Server-only: treasury key for /api/fund (tops fresh demo accounts up with
# testnet EURe on Arbitrum Sepolia). It needs EURe to send and a little
# Arbitrum Sepolia ETH for gas. Never NEXT_PUBLIC_. Funding is disabled when unset.
TREASURY_PRIVATE_KEY=0xyour-treasury-private-key
# Optional RPC overrides for /api/fund. Unset, the route uses the JAW RPC
# proxy authenticated with NEXT_PUBLIC_API_KEY (same endpoint as the SDK).
ARBITRUM_SEPOLIA_RPC_URL=
ARBITRUM_SEPOLIA_RPC_URL_FALLBACK=

# PostHog analytics (shared JAW project — same key as playground/docs/landing).
# Set to `true` only in the deployed environment.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-project-key
# Reverse-proxy path (see next.config.ts rewrites). Keep as `/analytics`.
NEXT_PUBLIC_POSTHOG_HOST=/analytics
