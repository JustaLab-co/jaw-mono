[
  {
    "id": "eip712-permit-anchor",
    "attack": "None. Baseline permit whose challenge was computed outside TypeScript with cast (see README).",
    "method": "eth_signTypedData_v4",
    "typedData": {
      "domain": {
        "name": "USD Coin",
        "version": "2",
        "chainId": 8453,
        "verifyingContract": "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913"
      },
      "primaryType": "Permit",
      "types": {
        "EIP712Domain": [
          {
            "name": "name",
            "type": "string"
          },
          {
            "name": "version",
            "type": "string"
          },
          {
            "name": "chainId",
            "type": "uint256"
          },
          {
            "name": "verifyingContract",
            "type": "address"
          }
        ],
        "Permit": [
          {
            "name": "owner",
            "type": "address"
          },
          {
            "name": "value",
            "type": "uint256"
          }
        ]
      },
      "message": {
        "owner": "0x9fD37D2cF1b32b3f7dBae480bbd44BE3De2A9e0F",
        "value": "1000"
      }
    },
    "expect": {
      "decision": "sign",
      "shows": ["USD Coin", "0x8335...2913", "Base · 8453", "1,000"],
      "challenge": "0x1ac8bbf747fd61141ce6ee5aedbac7a5dd76ebae42f964cc02f4d922d0d9876f"
    }
  },
  {
    "id": "eip712-wallet-sign-envelope",
    "attack": "None. The same permit through the ERC-7871 wallet_sign envelope, which keys re-serializes before display.",
    "method": "wallet_sign",
    "params": [
      {
        "request": {
          "type": "0x01",
          "data": {
            "domain": {
              "name": "USD Coin",
              "version": "2",
              "chainId": 8453,
              "verifyingContract": "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913"
            },
            "primaryType": "Permit",
            "types": {
              "EIP712Domain": [
                {
                  "name": "name",
                  "type": "string"
                },
                {
                  "name": "version",
                  "type": "string"
                },
                {
                  "name": "chainId",
                  "type": "uint256"
                },
                {
                  "name": "verifyingContract",
                  "type": "address"
                }
              ],
              "Permit": [
                {
                  "name": "owner",
                  "type": "address"
                },
                {
                  "name": "value",
                  "type": "uint256"
                }
              ]
            },
            "message": {
              "owner": "0x9fD37D2cF1b32b3f7dBae480bbd44BE3De2A9e0F",
              "value": "1000"
            }
          }
        },
        "address": "0x9fD37D2cF1b32b3f7dBae480bbd44BE3De2A9e0F"
      }
    ],
    "expect": {
      "decision": "sign",
      "shows": ["USD Coin", "Base · 8453", "1,000"],
      "challenge": "0x1ac8bbf747fd61141ce6ee5aedbac7a5dd76ebae42f964cc02f4d922d0d9876f"
    }
  },
  {
    "id": "eip712-misleading-field-name",
    "attack": "A field named \"recipient\" that holds the attacker. The address must be on screen under that name.",
    "method": "eth_signTypedData_v4",
    "typedData": {
      "domain": {
        "name": "Vault",
        "version": "1",
        "chainId": 8453,
        "verifyingContract": "0x1111111111111111111111111111111111111111"
      },
      "primaryType": "Order",
      "types": {
        "Order": [
          {
            "name": "recipient",
            "type": "address"
          },
          {
            "name": "amount",
            "type": "uint256"
          }
        ]
      },
      "message": {
        "recipient": "0xbad0000000000000000000000000000000000bad",
        "amount": "5"
      }
    },
    "expect": {
      "decision": "sign",
      "shows": ["recipient", "0xbad0…0bad"]
    }
  },
  {
    "id": "eip712-spoofed-verifying-contract",
    "attack": "Domain named \"USD Coin\" pointing at an attacker contract. The attacker address must be what the card shows.",
    "method": "eth_signTypedData_v4",
    "typedData": {
      "domain": {
        "name": "USD Coin",
        "version": "2",
        "chainId": 8453,
        "verifyingContract": "0xbad0000000000000000000000000000000000bad"
      },
      "primaryType": "Permit",
      "types": {
        "Permit": [
          {
            "name": "spender",
            "type": "address"
          },
          {
            "name": "value",
            "type": "uint256"
          }
        ]
      },
      "message": {
        "spender": "0xbad0000000000000000000000000000000000bad",
        "value": "1"
      }
    },
    "expect": {
      "decision": "sign",
      "shows": ["USD Coin", "0xbad0...0bad"],
      "hides": ["0x8335...2913"]
    }
  },
  {
    "id": "eip712-foreign-chain-id",
    "attack": "Connected on Base, typed data bound to Ethereum. The network shown must be the domain's, not the wallet's.",
    "method": "eth_signTypedData_v4",
    "typedData": {
      "domain": {
        "name": "USD Coin",
        "version": "2",
        "chainId": 1,
        "verifyingContract": "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913"
      },
      "primaryType": "Permit",
      "types": {
        "Permit": [
          {
            "name": "spender",
            "type": "address"
          },
          {
            "name": "value",
            "type": "uint256"
          }
        ]
      },
      "message": {
        "spender": "0xbad0000000000000000000000000000000000bad",
        "value": "1"
      }
    },
    "expect": {
      "decision": "sign",
      "shows": ["Ethereum · 1"],
      "hides": ["Base · 8453"]
    }
  },
  {
    "id": "eip712-domain-type-omits-chain-id",
    "attack": "types.EIP712Domain leaves out chainId while domain.chainId is 8453. The digest does not commit to any chain, so the signature replays on every chain.",
    "method": "eth_signTypedData_v4",
    "typedData": {
      "domain": {
        "name": "USD Coin",
        "version": "2",
        "chainId": 8453,
        "verifyingContract": "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913"
      },
      "primaryType": "Permit",
      "types": {
        "EIP712Domain": [
          {
            "name": "name",
            "type": "string"
          },
          {
            "name": "version",
            "type": "string"
          },
          {
            "name": "verifyingContract",
            "type": "address"
          }
        ],
        "Permit": [
          {
            "name": "spender",
            "type": "address"
          },
          {
            "name": "value",
            "type": "uint256"
          }
        ]
      },
      "message": {
        "spender": "0xbad0000000000000000000000000000000000bad",
        "value": "1"
      }
    },
    "expect": {
      "decision": "sign",
      "shows": ["USD Coin"]
    },
    "gap": {
      "note": "The domain card still reads \"Base · 8453\", a chain binding the signature does not have.",
      "expect": {
        "hides": ["Base · 8453"]
      }
    }
  },
  {
    "id": "eip712-unlimited-behind-zero",
