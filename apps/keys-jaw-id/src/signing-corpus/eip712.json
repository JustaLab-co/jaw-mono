  {
    "id": "eip712-unhashable-value",
    "attack": "Parses and renders, but a uint256 holds \"abc\", so no digest exists. Reachable only by skipping the SDK.",
    "method": "eth_signTypedData_v4",
    "typedData": {
      "domain": {
        "name": "Vault",
        "version": "1",
        "chainId": 8453,
        "verifyingContract": "0x1111111111111111111111111111111111111111"
      },
      "primaryType": "Order",
      "types": {
        "Order": [
          {
            "name": "amount",
            "type": "uint256"
          }
        ]
      },
      "message": {
        "amount": "abc"
      }
    },
    "expect": {
      "decision": "sign",
      "integrity": false,
      "prompts": false
    },
    "gap": {
      "note": "Sign is offered for a payload that cannot be hashed; it fails after the click instead of before it.",
      "expect": {
        "decision": "blocked"
      }
    }
  },
