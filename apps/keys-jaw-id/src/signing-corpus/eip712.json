  {
    "id": "eip712-vanity-address",
    "attack": "An address sharing the first and last four hex digits of a known one. Truncation renders both identically.",
    "method": "eth_signTypedData_v4",
    "typedData": {
      "domain": {
        "name": "Vault",
        "version": "1",
        "chainId": 8453,
        "verifyingContract": "0x1111111111111111111111111111111111111111"
      },
      "primaryType": "Transfer",
      "types": {
        "Transfer": [
          {
            "name": "to",
            "type": "address"
          }
        ]
      },
      "message": {
        "to": "0xbad0111111111111111111111111111111110bad"
      }
    },
    "expect": {
      "decision": "sign",
      "shows": ["0xbad0…0bad"]
    },
    "gap": {
      "note": "Only the copy button carries the full address; the screen cannot tell it from 0xbad0000…0bad.",
      "expect": {
        "shows": ["0xbad0111111111111111111111111111111110bad"]
      }
    }
  },
  {
    "id": "eip712-homoglyph-symbol",
    "attack": "A string field reading \"USDС\" with a Cyrillic С (U+0421).",
    "method": "eth_signTypedData_v4",
    "typedData": {
      "domain": {
        "name": "Vault",
        "version": "1",
        "chainId": 8453,
        "verifyingContract": "0x1111111111111111111111111111111111111111"
      },
      "primaryType": "Quote",
      "types": {
        "Quote": [
          {
            "name": "token",
            "type": "string"
          },
          {
            "name": "amount",
            "type": "uint256"
          }
        ]
      },
      "message": {
        "token": "USDС",
        "amount": "100"
      }
    },
    "expect": {
      "decision": "sign"
    },
    "gap": {
      "note": "Rendered verbatim, indistinguishable from ASCII \"USDC\". Replace this expectation with the treatment a fix picks.",
      "expect": {
        "hides": ["USDС"]
      }
    }
  },
