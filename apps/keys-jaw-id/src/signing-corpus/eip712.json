    "method": "eth_signTypedData_v4",
    "typedData": {
      "domain": {
        "name": "Vault",
        "version": "1",
        "chainId": 8453,
        "verifyingContract": "0x1111111111111111111111111111111111111111"
      },
      "primaryType": "Greeting",
      "types": {
        "Greeting": [
          {
            "name": "tip",
            "type": "uint256"
          },
          {
            "name": "settings",
            "type": "Settings"
          }
        ],
        "Settings": [
          {
            "name": "spender",
            "type": "address"
          },
          {
            "name": "allowance",
            "type": "uint256"
          }
        ]
      },
      "message": {
        "tip": "0",
        "settings": {
          "spender": "0xbad0000000000000000000000000000000000bad",
          "allowance": "115792089237316195423570985008687907853269984665640564039457584007913129639935"
        }
      }
    },
    "expect": {
      "decision": "sign",
      "shows": ["Greeting", "settings", "Unlimited", "0xbad0…0bad"]
    }
  },
  {
    "id": "eip712-deep-nesting",
    "attack": "The spender sits 14 structs deep, past the depth the tree renders.",
    "method": "eth_signTypedData_v4",
    "typedData": {
      "domain": {
        "name": "Vault",
        "version": "1",
        "chainId": 8453,
        "verifyingContract": "0x1111111111111111111111111111111111111111"
      },
      "primaryType": "Root",
      "types": {
        "Root": [
          {
            "name": "next",
            "type": "L1"
          }
        ],
        "L1": [
          {
            "name": "next",
            "type": "L2"
          }
        ],
        "L2": [
          {
            "name": "next",
            "type": "L3"
          }
        ],
        "L3": [
          {
            "name": "next",
            "type": "L4"
          }
        ],
        "L4": [
          {
            "name": "next",
            "type": "L5"
          }
        ],
        "L5": [
          {
            "name": "next",
            "type": "L6"
          }
        ],
        "L6": [
          {
            "name": "next",
            "type": "L7"
          }
        ],
        "L7": [
          {
            "name": "next",
            "type": "L8"
          }
        ],
        "L8": [
          {
            "name": "next",
            "type": "L9"
          }
        ],
        "L9": [
          {
            "name": "next",
            "type": "L10"
          }
        ],
        "L10": [
          {
            "name": "next",
            "type": "L11"
          }
        ],
        "L11": [
          {
            "name": "next",
            "type": "L12"
          }
        ],
        "L12": [
          {
            "name": "next",
            "type": "Leaf"
          }
        ],
        "Leaf": [
          {
            "name": "spender",
            "type": "address"
          }
        ]
      },
      "message": {
        "next": {
          "next": {
            "next": {
              "next": {
                "next": {
                  "next": {
                    "next": {
                      "next": {
                        "next": {
                          "next": {
                            "next": {
                              "next": {
                                "next": {
                                  "spender": "0xbad0000000000000000000000000000000000bad"
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "expect": {
      "decision": "sign",
      "shows": ["Root"]
    },
    "gap": {
      "note": "Eip712Tree stops at MAX_DEPTH 12 and renders \"…\"; the spender is visible nowhere.",
      "expect": {
        "shows": ["0xbad0…0bad"]
      }
    }
  },
