NEXT_PUBLIC_PROVIDER_URL=<YOUR_PROVIDER_URL>
NEXT_PUBLIC_CHAIN_ID=<1 | 11155111 | 8453>
# Comma-separated embedder hostnames (no protocol/port/path) allowed to render
# the keys iframe on browsers without IntersectionObserver v2. Empty = popup-only.
JAW_TRUSTED_HOSTS=

# The api key the CLI bridge operates under when the CLI brought none. Belongs
# to a workspace created for the CLI, so its usage does not attribute to this
# app's own project. Served per request by /api/cli-key, so rotating it is a
# change here rather than a rebuild. Empty = the bridge refuses a CLI that sent
# no key, which is how it behaved before this existed.
JAW_CLI_API_KEY=
