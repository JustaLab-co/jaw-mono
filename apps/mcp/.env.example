# Postgres connection string.
DATABASE_URL=

# The origin clients reach. It is the OAuth issuer; the MCP resource is <origin>/mcp.
JAW_MCP_PUBLIC_URL=

# The keys.jaw.id origin that hosts /authorize and /approve/<id>.
JAW_KEYS_URL=

# Comma-separated base64url keys of 32 bytes, newest first.
JAW_MCP_SEALING_KEYS=

# 84532 (default) or 8453, and an RPC for that chain (its public RPC when unset).
JAW_MCP_CHAIN_ID=
JAW_MCP_RPC_URL=

# RPC for ENS lookups.
JAW_MCP_MAINNET_RPC_URL=

# Proxies in front that append to x-forwarded-for. Production behind your own
# proxy or load balancer must set this to the number of proxies. Unset or 0:
# x-forwarded-for is ignored and unauthenticated routes are limited per
# x-real-ip, which Vercel sets itself; with neither, they get no per-IP limit.
# Authenticated /mcp calls are always limited per connection.
JAW_MCP_TRUSTED_PROXY_HOPS=

# host:port list jaw_quote and jaw_pay_and_fetch may reach over plain http or a
# private address. Local testing only.
JAW_MCP_INSECURE_FETCH_HOSTS=

# JAW api key for the ERC-20 paymaster that charges a refill's gas. Without it
# no refill runs.
JAW_MCP_API_KEY=

# Base units a refill brings the payer up to (default 250000, 0.25 USDC), so
# most payments need no refill. The budget's daily cap still bounds it.
JAW_MCP_FLOAT_TARGET=

# Bearer secret for /api/cron/reconcile and /api/metrics. Unset, both answer 401.
JAW_MCP_CRON_SECRET=

# Seconds between reconciler runs inside the server, for a container where
# nothing calls the cron route.
JAW_MCP_RECONCILE_EVERY=
